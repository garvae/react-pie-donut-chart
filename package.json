{
  "version": "1.1.0",
  "description": "Lightweight library allows you to create \"pie\" and \"donut\" charts easily",
  "keywords": [
    "arc",
    "arc-chart",
    "area-chart",
    "chart",
    "charting",
    "charts",
    "component",
    "data visualization",
    "donut-chart",
    "pie",
    "pie-chart",
    "radial",
    "react",
    "react-component",
    "reactjs",
    "svg",
    "typescript",
    "visualization"
  ],
  "homepage": "https://github.com/garvae/react-pie-donut-chart",
  "funding": {
    "url": "https://ko-fi.com/garvae"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/garvae/react-pie-donut-chart"
  },
  "bugs": {
    "url": "https://github.com/garvae/react-pie-donut-chart/issues"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "umd:main": "dist/index.js",
  "module": "dist/react-pie-donut-chart.esm.js",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-pie-donut-chart.esm.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["*.d.ts", "dist"],
  "sideEffects": false,
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "analyze": "size-limit",
    "build": "npm run tsup:compile",
    "build:watch": "tsup --watch",
    "check:all": "npm run check && npm run type-check && npm run type-check:test && npm run build && npm run test && npm run test:cover && npm run pack:smoke && npm run size",
    "copy:license": "cpx LICENSE dist",
    "copy:readme": "cpx README.md dist",
    "copy:types": "cpx src/types/index.d.ts dist",
    "delete:dist": "rimraf dist",
    "delete:sourcemaps": "del dist/**/*.js.map",
    "generate:packagejson": "node scripts/generate-package-json.js",
    "generate:ts-config": "node scripts/generate-ts-config.js && biome format --write tsconfig.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:js": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "pack:smoke": "node scripts/package-smoke-test.js",
    "postbuild": "npm run generate:packagejson && npm run copy:license && npm run copy:types && npm run copy:readme",
    "postinstall": "husky install",
    "postprepare": "npm run generate:packagejson",
    "pre-commit": "npm run check && npm run test",
    "prebuild": "npm run generate:ts-config && npm run delete:dist && npm run check && npm run type-check",
    "prepare": "husky install",
    "pretest": "npm run generate:ts-config",
    "release:pack": "node scripts/release/pack-release-tarball.js",
    "release:prepare": "node scripts/release/prepare-release.js",
    "release:verify-version": "node scripts/verify-npm-version-not-published.js",
    "demo:install": "pnpm run build && pnpm --dir demo install",
    "demo:dev": "pnpm run build && pnpm --dir demo dev --host",
    "demo:build": "pnpm run build && pnpm --dir demo build",
    "demo:preview": "pnpm --dir demo preview --host",
    "tsup:compile": "tsup",
    "size": "size-limit",
    "test": "jest",
    "test:cover": "jest --collect-coverage",
    "type-check": "tsc --noEmit -p tsconfig.build.json",
    "type-check:test": "tsc --noEmit -p tsconfig.test.json",
    "version:patch": "npm version patch"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md}": ["biome check --write --no-errors-on-unmatched"]
  },
  "peerDependencies": {
    "react": ">=16"
  },
  "name": "@garvae/react-pie-donut-chart",
  "author": "Garvae",
  "publishConfig": {
    "access": "public"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run pre-commit"
    }
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "15 KB"
    },
    {
      "path": "dist/react-pie-donut-chart.esm.js",
      "limit": "15 KB"
    }
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@size-limit/preset-small-lib": "^8.0.1",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^13.2.1",
    "@types/jest": "^28.1.6",
    "@types/node": "^18.7.13",
    "@types/react": "^18.0.17",
    "@types/react-dom": "^18.0.6",
    "@types/testing-library__jest-dom": "5.14.9",
    "cpx": "^1.5.0",
    "del": "^8.0.1",
    "husky": "^8.0.1",
    "jest": "^28.1.3",
    "jest-environment-jsdom": "^28.1.3",
    "lint-staged": "^12.3.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^6.1.3",
    "semver": "^7.7.3",
    "size-limit": "^8.0.1",
    "ts-jest": "^28.0.7",
    "tslib": "^2.4.0",
    "tsup": "^8.5.1",
    "typescript": "^4.6.4"
  }
}
